PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/pizza-platform?retryWrites=true&w=majority

JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
FRONTEND_URL=http://localhost:5173

# Email Configurations (leave blank to auto-generate Ethereal test account)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Razorpay Test Mode (use dummy values for simulation mode)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=rzp_test_yoursecret
